# ============================================================================
#  WHITELIST — only the server and tools source (plus README) ever go to GitHub.
#  RELEASE/, saves, APKs/IPAs, build output, logs etc. are all outside this.
#  The rules further down still filter what's INSIDE work/server and work/tools.
# ============================================================================
/*
!/.gitignore
!/README.md
!/windstock site/
!/work/
/work/*
!/work/server/
!/work/tools/
!/PoGoAvatarParser/
# PoGoAvatarParser is kept whole, including its output (textures/, avatars/,
# objs/, sheets/, random/, variants/, catalog.json). That is a deliberate
# choice by the repo owner -- the extracted tiles and built models are what
# make the package usable straight after a clone, and this checkout is kept
# private and never published. PoGoAvatarParser/.gitignore negates the global
# *.png / *.glb / *.json rules above so those files are actually not dropped;
# delete that file to keep only the source.

# ============================================================================
#  DO NOT COMMIT — Niantic copyrighted material (APK, decompiled assets, data)
#  Distributing these is a copyright/ToS violation and will likely get DMCA'd.
#  Anyone using this repo supplies their own legally-obtained 0.29 APK.
# ============================================================================
*.apk
*.idsig
work/extracted/
**/game_master.bin
work/tools/gm_2016.txt
work/tools/global-metadata.patched.dat
**/global-metadata*.dat

# ----------------------------------------------------------------------------
#  SECURITY — never commit private keys / certs (regenerate with gen_certs.py)
# ----------------------------------------------------------------------------
work/server/certs/
*.key
*.keystore
*.srl
*.csr

# ----------------------------------------------------------------------------
#  Third-party tools & generated protobufs (download/build these yourself)
# ----------------------------------------------------------------------------
work/tools/POGOProtos-*/
work/tools/*.jar
work/tools/*.zip
work/tools/*.tar.gz
work/tools/*.bat
work/tools/*.exe
work/tools/*.msi
work/tools/appium-settings.apk
work/tools/frida-server*
work/tools/gadget-config.json

# ----------------------------------------------------------------------------
#  Build artifacts / caches
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
work/server/dist/
work/server/build/
work/server/*.spec

# ----------------------------------------------------------------------------
#  Personal screenshots (they show your real location / username)
# ----------------------------------------------------------------------------
*.png
work/*.png
# ...except our own Bracky artwork, which the server window needs.
!work/server/brand/*.png

# Local tooling config (not part of the project)
.claude/

# OS junk
.DS_Store
Thumbs.db

# ============================================================================
#  PUBLISH = SOURCE ONLY. Everything below is a built copy, a snapshot, runtime
#  state, personal data, or Niantic material -- none of it belongs in the repo.
# ============================================================================
#  Packaged builds / distribution snapshots (each a full copy of the tree)
/RELEASE/
/SOURCE/
/server/
/drive/
work/PoGO-Server-Ready/
work/server/dist/
work/server/build/

#  Out-of-scope subprojects (their own source lives outside this repo)
work/goserver/
work/il2cpp/
work/mods/
work/site/
work/server/site/

#  Extracted app/engine data (Niantic copyright, and thousands of files)
work/unity/
work/v035/
work/extracted/
work/tools/_bundle_cache/
**/bin/Data/
Start-POI-Exporter.bat

#  Niantic app builds (copyright) + the untrusted third-party server folder
*.ipa
APK&IPA/
PoGO server but better!/

#  Runtime state, player saves (real usernames = personal data), logs, big data
work/server/data/
work/server/assets/
work/server/assets_ios/
work/server/assets_plain/
work/server/photos/
*.bin
*.bak
*.bak-*
*.log
sideloadlydaemon.log

#  Research art + the game font pulled from the client (Niantic copyright; the
#  server downloads/extracts them itself -- see research.py)
work/server/research_art/

# ----------------------------------------------------------------------------
#  Vendored Leaflet (BSD-2, LICENSE included). Its marker/layer icons are PNGs,
#  which the blanket *.png rule above would drop -- and a map with no markers is
#  the bug that made us vendor it in the first place.
# ----------------------------------------------------------------------------
!work/server/webassets/**

#  Shop and item icons lifted from the client, same reason as research_art/.
work/server/shopicons/
# ============================================================================
#  Chucny's Translator (project2/) - the app and the build tooling that turns it
#  into an APK. The whitelist at the top of this file predates it, so the tree is
#  re-included here - SOURCE ONLY, for the same reason the rules below exist:
#  no APKs (the Niantic client, or anything carrying it, stays out), no staged
#  32-bit runtime, no payload containers, no Gradle output. Build those locally:
#  see project2/README-OBFUSCATION.md.
# ============================================================================
!/project2/
/project2/build/launcher/
/project2/build/payloads/
/project2/build/bundled-assets/
/project2/build/__pycache__/
/project2/launcher/app/build/
/project2/launcher/.gradle/
/project2/launcher/local.properties
#  The octicon sources the GitHub button is rasterised from are PNGs, which the
#  blanket *.png rule above would drop.
!/project2/build/icons/
