# ============================================================================
#  TRACKED — the repository ROOT is tracked as-is. Nothing at the root is
#  blanket-ignored any more, so root-level files such as database.py, tools/,
#  server/ and any script or folder you drop at the top level show up in
#  `git status` normally.
#
#  The rules further down still exclude secrets (private keys, certs), Niantic
#  app builds and generated/runtime output. Those are deliberate — see the
#  SECURITY and PUBLISH sections below.
# ============================================================================

# ============================================================================
#  DO NOT COMMIT — Niantic copyrighted material (APK, decompiled assets, data)
#  Distributing these is a copyright/ToS violation and will likely get DMCA'd.
#  Anyone using this repo supplies their own legally-obtained 0.29 APK.
# ============================================================================
*.apk
*.idsig
#  ...except the gnirehtet phone app the USB mode needs. It is a third-party
#  tool (not Niantic material), so it is safe to ship with the server.
!src/server/gnirehtet.apk
extracted/
tools/gm_2016.txt
tools/global-metadata.patched.dat
**/global-metadata*.dat
**/game_master.bin

# ----------------------------------------------------------------------------
#  SECURITY — never commit private keys / certs (regenerate with gen_certs.py)
# ----------------------------------------------------------------------------
server/certs/
*.key
*.keystore
*.srl
*.csr

# ----------------------------------------------------------------------------
#  Third-party tools & generated protobufs (download/build these yourself)
# ----------------------------------------------------------------------------
tools/POGOProtos-*/
tools/*.jar
tools/*.zip
tools/*.tar.gz
tools/*.bat
tools/*.exe
tools/*.msi
tools/appium-settings.apk
tools/frida-server*
tools/gadget-config.json

# ----------------------------------------------------------------------------
#  Build artifacts / caches
# ----------------------------------------------------------------------------
__pycache__/
*.pyc
server/dist/
server/build/
server/*.spec

# ----------------------------------------------------------------------------
#  Personal screenshots (they show your real location / username)
# ----------------------------------------------------------------------------
*.png
# ...except our own Windstock artwork, which the server window needs.
!server/brand/*.png

# Local tooling config (not part of the project)
.claude/
.freebuff/

# OS junk
.DS_Store
Thumbs.db

# ============================================================================
#  PUBLISH = SOURCE ONLY. Everything below is a built copy, a snapshot, runtime
#  state, personal data, or Niantic material -- none of it belongs in the repo.
# ============================================================================
#  Packaged builds / distribution snapshots (each a full copy of the tree)
/RELEASE/
/SOURCE/
/drive/
server/dist/
server/build/

#  Out-of-repo artifacts (their own source lives outside this repo)
goserver/
il2cpp/
mods/
site/
server/site/

#  Extracted app/engine data (Niantic copyright, and thousands of files)
unity/
v035/
extracted/
tools/_bundle_cache/
**/bin/Data/
Start-POI-Exporter.bat

#  Niantic app builds (copyright) + the untrusted third-party server folder
*.ipa
APK&IPA/
PoGO server but better!/

#  Runtime state, player saves (real usernames = personal data), logs, big data
server/data/
server/assets/
server/assets_ios/
server/assets_plain/
server/photos/
*.bin
*.bak
*.bak-*
*.log
sideloadlydaemon.log

# ---------------------------------------------------------------------------
#  Same rules for the src/ layout (the tree as it is now). Without these the
#  151 shipped model bundles (67 MB of Niantic material) show up as untracked
#  and are one `git add -A` away from being committed.
# ---------------------------------------------------------------------------
src/server/data/
src/server/assets/
src/server/assets_ios/
src/server/assets_plain/
src/server/photos/
src/server/certs/
src/server/data/extra_digest.json
src/server/data/asset_backups/
